# Board and source-synchronous video clocks.  Keep these explicit so the
# timing engine never falls back to a 1 MHz inferred clock.
create_clock -name {sys_clk_25m} [get_ports {sys_clk}] -period {40.000} -waveform {0.000 20.000}
create_clock -name {hdmi_rx_pclk_74m25} [get_ports {pixclk_in}] -period {13.468} -waveform {0.000 6.734}
create_clock -name {hdmi_tx_clk_74m25} [get_nets {pix_clk_1080p}] -period {13.468} -waveform {0.000 6.734}
create_clock -name {cfg_clk_10m} [get_nets {cfg_clk}] -period {100.000} -waveform {0.000 50.000}
create_clock -name {ddr_ref_clk_125m} [get_ports {ddr_ref_clk_p}] -period {8.000} -waveform {0.000 4.000}


# 2026-10-11: video_sel pin constraints removed together with the unused SFP
