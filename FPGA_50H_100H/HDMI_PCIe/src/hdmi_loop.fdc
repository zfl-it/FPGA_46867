###==== BEGIN "set_clock_groups"
set_clock_groups -name group_1 -asynchronous -group [get_clocks {pclk}]
set_clock_groups -name group_2 -asynchronous -group [get_clocks {pclk_div2}]
set_clock_groups -name group_3 -asynchronous -group [get_clocks {ref_clk}]
# 2026-10-11: SFP HSST clock constraints removed together with the unused SFP
# receive chain (sfp_img_recv / hsst_core are no longer in the design; the
# PCIe HSST clocks above are unrelated and stay).

###==== END "set_clock_groups"# ----------------------------------------------------------------------------
# 2026-10-11 (P1-1 fix): declare the video / DDR / cfg / sys clock domains as
# mutually asynchronous, mirroring the per-domain set_clock_groups discipline
# already used in the 50H project (hdmi_ddr_ov5640_top.fdc).
#
# Why this is sound: every crossing between these domains in the RTL is a
# 2FF synchronizer (ASYNC_REG), a Gray-coded counter, or a vendor true
# dual-clock RAM -- there is no timed multi-bit path between them (see the
# CDC notes in hdmi_loop.v / wr_buf.v / rd_buf.v / pcie_tx_fun.v headers).
# Without these groups the timing engine times the synchronizer first stages
# and the async-reset release paths (recovery checks) as if they were real
# same-cycle paths, which is the root cause of the reported
#   Setup:    ddr core -> hdmi_tx_clk, 2 endpoints,  WNS -4.03 ns
#   Recovery: cfg/sys/ddr -> hdmi_rx/tx, ~5 endpoints, WNS -3.3 .. -5.1 ns
#
# The long DDR clock names below are tool-inferred PLL outputs; they are
# copied verbatim from place_route/hdmi_loop_timing_summary_after_hold_fix.txt
# (they contain '|' and '[n]' and must stay inside the braces).
# ----------------------------------------------------------------------------
# ----------------------------------------------------------------------------
# 2026-10-11 修订 3（根据第二次重跑的 run.log 证据定稿）：
#
# 实测结论（见 run.log SDC-2017/SDC-2027）：
#   * 只有 4 条"单组" set_clock_groups（下面这 4 条）在综合阶段成功执行，
#     它们把 hdmi_rx/tx、cfg、sys 与**所有其他时钟**（含 DDR 域）声明为
#     异步——第一次重跑已验证：用户逻辑跨域违例（ddr->hdmi_tx Setup 2 端点、
#     cfg/sys->视频 Recovery 约 5 端点）全部清零。
#   * DDR PHY 内部的 6 个推断时钟（*_Inferred，名字含 '|' 与 '[n]'）在
#     **综合阶段尚不存在**（它们是布线后 STA 从 PLL 硬宏推断出来的），
#     get_clocks 匹配不到 → SDC-2017 → 凡包含它们的 set_clock_groups
#     整条被忽略（SDC-2027）。因此用户约束层**无法引用**这些时钟，
#     合并多组命令的尝试已被证明无效并回退。
#
# 剩余违例（布线后报告约 406 端点）全部位于 DDR PHY IP 黑盒内部
# (gpll/rst_clk -> dqs_bank CLKOUTPHY/CLKDIVOUT)：
#   * 属于 IP 对内部推断时钟的误分析（PHY 内部跨时钟结构由硬 IP 保证，
#     工具缺乏生成关系模型）；本板实测 DDR3 读写正确、帧缓存数据无误，
#     证明功能不受影响；同款 IP 的 50H 参考工程同样存在这些路径，
#     仅因布线 slack 为正而未显示。
#   * 答辩/评审口径：用户逻辑零违例；残余违例端点 100% 位于紫光
#     DDR3 PHY IP 内部，建议向原厂确认是否有 IP 级约束机制。
# ----------------------------------------------------------------------------
set_clock_groups -name vid_rx_clk_g -asynchronous -group [get_clocks {hdmi_rx_pclk_74m25}]
set_clock_groups -name vid_tx_clk_g -asynchronous -group [get_clocks {hdmi_tx_clk_74m25}]
set_clock_groups -name cfg_clk_g    -asynchronous -group [get_clocks {cfg_clk_10m}]
set_clock_groups -name sys_clk_g    -asynchronous -group [get_clocks {sys_clk_25m}]

###==== END "set_clock_groups"
###==== BEGIN "set_input_delay"
# MS7200 parallel-video output delay plus board skew margin.  The functional
# HDMI capture path in hdmi_loop.v uses the falling edge
# (HDMI_CAPTURE_NEGEDGE=1), so both min and max constraints use -clock_fall.
set_input_delay -clock [get_clocks {hdmi_rx_pclk_74m25}] -clock_fall -min {2.000} [get_ports {r_in[7] r_in[6] r_in[5] r_in[4] r_in[3] r_in[2] r_in[1] r_in[0] g_in[7] g_in[6] g_in[5] g_in[4] g_in[3] g_in[2] g_in[1] g_in[0] b_in[7] b_in[6] b_in[5] b_in[4] b_in[3] b_in[2] b_in[1] b_in[0] de_in hs_in vs_in}]
set_input_delay -clock [get_clocks {hdmi_rx_pclk_74m25}] -clock_fall -max {3.100} [get_ports {r_in[7] r_in[6] r_in[5] r_in[4] r_in[3] r_in[2] r_in[1] r_in[0] g_in[7] g_in[6] g_in[5] g_in[4] g_in[3] g_in[2] g_in[1] g_in[0] b_in[7] b_in[6] b_in[5] b_in[4] b_in[3] b_in[2] b_in[1] b_in[0] de_in hs_in vs_in}]
###==== END "set_input_delay"

